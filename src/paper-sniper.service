[Unit]
Description=Agent Solana Trader (pump.fun, Papierbetrieb; Live nur mit LIVE=1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/agent-solana-trader
Environment=RUN_S=315360000
Environment=BUY_SOL=0.20
Environment=TP=5.00
Environment=SL=0.90
Environment=HOLD=600
Environment=SAMPLE_EVERY=20
Environment=MIN_MCAP=15
Environment=MAX_MCAP=500
Environment=MAX_TRACK=800
Environment=POLL_S=2
Environment=CHECK_S=1
Environment=LIVE=0
Environment=PAPER=1
Environment=PP_VIA=jupiter
Environment=SLIP=25
Environment=TRIGGER_X=2.0
Environment=LIVE_SOL=0.20
Environment=LIVE_TP=0
Environment=LIVE_SL=0.90
Environment=BE_AT=1.20
Environment=BE_FLOOR=0.98
Environment=TRAIL=0.90
Environment=LIVE_HOLD=3600
Environment=MAX_BUY_SOL=0.20
Environment=MAX_TRADES_TAG=15
Environment=WHALE_MAX_FLOAT_PCT=10
Environment=MIN_RESERVE_SOL=3
Environment=MAX_DAY_LOSS_SOL=0.08
Environment=PAPER_TRAIL=0.90
Environment=PAPER_TRAIL_FROM=1.20
Environment=OBSERVE_S=1800
Environment=MAX_RESERVE_SOL=10
Environment=CLOSE_ATA=1
ExecStart=/usr/bin/python3 /opt/agent-solana-trader/src/paper-sniper.py
StandardOutput=journal
StandardError=journal
Nice=10
CPUQuota=50%
MemoryMax=512M
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
